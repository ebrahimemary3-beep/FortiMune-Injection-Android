<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".FortiMuneApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_fortimune"
        android:label="FortiMune Injection"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">
        <meta-data android:name="com.onesignal.NotificationServiceExtension" android:value="com.fortimune.injection.FortiMuneNotificationService" />
        <meta-data android:name="com.onesignal.NotificationAccentColor.DEFAULT" android:value="FF056DB7" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
